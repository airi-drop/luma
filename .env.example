# Luma — Environment Variables
# Copy this file to .env and fill in your keys.
# Local parsing works without any AI keys configured.

# ─── AI Provider ──────────────────────────────────────
# Choose: "gemini" (default), "openai", or "openrouter"
# VITE_AI_PROVIDER=gemini

# Override model ID (optional — uses provider default if empty)
# VITE_AI_MODEL=

# ─── API Keys ─────────────────────────────────────────
# Universal key (works with any provider above)
# VITE_AI_API_KEY=

# Provider-specific keys (override universal key)
# VITE_GEMINI_API_KEY=
# VITE_OPENAI_API_KEY=
# VITE_OPENROUTER_API_KEY=
