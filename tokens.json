{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A cozy, customizable personal finance space — not a corporate dashboard. Warm earthy tones, soft rounded surfaces, serif display numbers for budget hero moments, and a human-first Indonesian voice. Mobile-first (480px max), offline-first, with theme and character customization.\n",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.91,
          0.659,
          0.341
        ],
        "hex": "#e8a857"
      }
    },
    "primary-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.839,
          0.627
        ],
        "hex": "#f4d6a0"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.561,
          0.722,
          0.588
        ],
        "hex": "#8fb896"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.851,
          0.424,
          0.373
        ],
        "hex": "#d96c5f"
      }
    },
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.078,
          0.063
        ],
        "hex": "#1a1410"
      }
    },
    "canvas-card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.165,
          0.129,
          0.106
        ],
        "hex": "#2a211b"
      }
    },
    "canvas-card-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.204,
          0.165,
          0.133
        ],
        "hex": "#342a22"
      }
    },
    "on-canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.953,
          0.863
        ],
        "hex": "#fff3dc"
      }
    },
    "on-canvas-secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.804,
          0.745,
          0.659
        ],
        "hex": "#cdbea8"
      }
    },
    "on-canvas-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.612,
          0.553,
          0.482
        ],
        "hex": "#9c8d7b"
      }
    },
    "hairline": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.239,
          0.196,
          0.161
        ],
        "hex": "#3d3229"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "default": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "card": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    },
    "section": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "large": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "hero": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "full": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "hero-number": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'Fraunces', Georgia, serif",
        "fontSize": {
          "value": 44,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "page-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'Fraunces', Georgia, serif",
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      }
    },
    "section-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 20,
          "unit": "px"
        },
        "fontWeight": 700
      }
    },
    "card-title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 700
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 15,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 12,
          "unit": "px"
        },
        "fontWeight": 400
      }
    },
    "micro-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "'DM Sans', system-ui, sans-serif",
        "fontSize": {
          "value": 11,
          "unit": "px"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.04,
          "unit": "em"
        }
      }
    }
  }
}
